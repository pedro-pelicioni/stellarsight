{
  "name": "@stellarsight/agent",
  "version": "0.2.0",
  "type": "module",
  "description": "STELLARSIGHT agent surface — MCP server + x402 payment client for the Stellar Bazaar",
  "author": "Pedro Pelicioni",
  "bin": {
    "stellarsight-mcp": "./src/mcp-server.mjs",
    "stellarsight": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/pay.mjs",
    "./pay": "./src/pay.mjs",
    "./bazaar": "./src/bazaar.mjs",
    "./mcp-server": "./src/mcp-server.mjs"
  },
  "files": [
    "src",
    "!src/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "x402",
    "stellar",
    "mcp",
    "model-context-protocol",
    "agent-payments",
    "bazaar",
    "stellarsight"
  ],
  "homepage": "https://github.com/pedro-pelicioni/stellarsight/tree/main/apps/agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedro-pelicioni/stellarsight.git",
    "directory": "apps/agent"
  },
  "bugs": {
    "url": "https://github.com/pedro-pelicioni/stellarsight/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "mcp": "node src/mcp-server.mjs",
    "demo": "node src/cli.mjs",
    "test": "node --test src/replay-guard.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "@x402/stellar": "^2.21.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.76"
  },
  "license": "Apache-2.0"
}
