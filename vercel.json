{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace apps/web",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "{packages/index/src/**,docs/status/**,apps/agent/src/**,apps/facilitator/src/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/discovery/resources",
      "destination": "/api/discovery/resources"
    },
    {
      "source": "/discovery/search",
      "destination": "/api/discovery/search"
    },
    {
      "source": "/discovery/health",
      "destination": "/api/discovery/health"
    },
    {
      "source": "/discovery/integrity",
      "destination": "/api/discovery/integrity"
    },
    {
      "source": "/discovery/:path*",
      "destination": "/api/discovery/unknown"
    },
    {
      "source": "/supported",
      "destination": "/api/facilitator"
    },
    {
      "source": "/verify",
      "destination": "/api/facilitator"
    },
    {
      "source": "/settle",
      "destination": "/api/facilitator"
    },
    {
      "source": "/health",
      "destination": "/api/facilitator"
    },
    {
      "source": "/events",
      "destination": "/api/facilitator"
    },
    {
      "source": "/playground/fund",
      "destination": "/api/playground/fund"
    },
    {
      "source": "/explorer/feed",
      "destination": "/api/explorer/feed"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api/mcp"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/seller"
    },
    {
      "source": "/.well-known/x402",
      "destination": "/api/seller"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|svg|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
