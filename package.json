{
  "name": "stellarsight",
  "version": "1.0.0",
  "description": "STELLARSIGHT \u2014 find what to pay for on Stellar. Self-hosted x402 facilitator, paid API seller and a bazaar discovery index.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "setup": "node scripts/setup-testnet.mjs",
    "dev:facilitator": "STELLARSIGHT_ALLOW_PRIVATE_RESOURCES=1 node apps/facilitator/src/server.mjs",
    "dev:seller": "STELLARSIGHT_ALLOW_PRIVATE_RESOURCES=1 node apps/seller/src/server.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:all": "concurrently -n facilitator,seller -c cyan,magenta \"npm run dev:facilitator\" \"npm run dev:seller\"",
    "demo": "node scripts/demo-loop.mjs",
    "cleanup": "node scripts/cleanup-legacy-asset.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify:api": "node scripts/verify-serverless.mjs",
    "verify:conformance": "node scripts/verify-conformance.mjs",
    "verify:rejections": "node scripts/verify-rejections.mjs",
    "evidence:batch": "node scripts/evidence-batch.mjs",
    "evidence:build": "node scripts/build-evidence.mjs",
  "evidence:footprint": "node scripts/soroban-footprint.mjs",
  "audit:licenses": "node scripts/license-audit.mjs",
    "eval:search": "node scripts/eval-search.mjs",
    "eval:search:report": "node scripts/eval-search.mjs --report",
    "load:baseline": "node scripts/load-baseline.mjs",
  "latency:discovery": "node scripts/latency-baseline.mjs",
    "test:agent": "node --test apps/agent/src/replay-guard.test.mjs",
    "demo:agent": "node apps/agent/src/cli.mjs",
    "mcp": "node apps/agent/src/mcp-server.mjs",
    "check:bazaar": "node scripts/check-bazaar-client.mjs",
  "verify:interop": "node scripts/interop-discovery.mjs",
    "docs:sync": "node scripts/sync-docs-site.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "^2.21.0",
    "@x402/express": "^2.21.0",
    "@x402/extensions": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "@x402/stellar": "^2.21.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "picocolors": "^1.1.1",
    "redis": "^6.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
